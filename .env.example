# =============================================================================
#  洗剤価格 楽天 + Amazon 比較・自動投稿システム 認証情報テンプレート
# =============================================================================
#
#  使い方:
#    1) このファイルをコピーして .env を作る
#         cp .env.example .env
#    2) 下の「★ここに貼る★」と書かれた行の = の右側にIDを貼り付ける
#         例:  RAKUTEN_APP_ID=1234567890abcdef
#    3) ファイル権限を絞る (推奨)
#         chmod 600 .env
#    4) スクリプトを実行 (python-dotenv が自動で .env を読み込む)
#         python main.py collect
#
#  ⚠ このファイル自身 (.env.example) はテンプレなのでコミットしてOK。
#  ⚠ .env 本体は .gitignore で除外済み。絶対にコミットしないこと。
#  ⚠ 値はクォート不要・両端スペース無し・行頭に余計な空白を入れない。
#       OK   RAKUTEN_APP_ID=abcd1234
#       NG   RAKUTEN_APP_ID = "abcd1234"   ← スペースとクォートが入っている
# =============================================================================


# =============================================================================
#  ◆ 楽天市場 (必須)
# =============================================================================

# -----------------------------------------------------------------------------
# [1] 楽天 アプリID (applicationId)  (必須)
# -----------------------------------------------------------------------------
#   取得先: https://webservice.rakuten.co.jp/app/list
#   形式  : UUID 36文字 (例 e5e2671a-b454-4e6f-xxxx-xxxxxxxxxxxx)
#           ※ 2026-05-13 の仕様変更で旧19桁数字形式から変更されました。
#                                                ★ここに貼る★
RAKUTEN_APP_ID=

# -----------------------------------------------------------------------------
# [2] 楽天 アクセスキー (accessKey)  (必須・新仕様)
# -----------------------------------------------------------------------------
#   取得先: https://webservice.rakuten.co.jp/app/list (アプリ詳細)
#   形式  : 長い英数字文字列
#                                                ★ここに貼る★
RAKUTEN_ACCESS_KEY=

# -----------------------------------------------------------------------------
# [3] 楽天 アフィリエイトID  (報酬を得たいなら必須)
# -----------------------------------------------------------------------------
#   取得先: https://affiliate.rakuten.co.jp/
#   形式  : xxxxxxxx.xxxxxxxx.xxxxxxxx.xxxxxxxx  (ドット区切りの英数字)
#                                                ★ここに貼る★
RAKUTEN_AFFILIATE_ID=

# -----------------------------------------------------------------------------
# [4] 楽天 Referer  (Webアプリタイプの場合 必須)
# -----------------------------------------------------------------------------
#   楽天アプリ登録時の「許可されたウェブサイト」と一致するURLを指定。
#   例: https://your-site.example.com
#                                                ★ここに貼る★
RAKUTEN_REFERER=

# -----------------------------------------------------------------------------
# [5] 楽天 配送地域  (任意)
# -----------------------------------------------------------------------------
#   hokkaido tohoku kanto shinetsu hokuriku tokai kinki chugoku shikoku kyushu okinawa
#                                                ★ここに貼る★
RAKUTEN_REGION=kanto


# =============================================================================
#  ◆ Amazon (検索URLにアフィリエイトタグを付与)
# =============================================================================

# -----------------------------------------------------------------------------
# [6] Amazon アソシエイト トラッキングID  (報酬を得たいなら必須)
# -----------------------------------------------------------------------------
#   取得先: https://affiliate.amazon.co.jp/
#   形式  : xxxxxx-22 等 (国別の末尾-22)
#                                                ★ここに貼る★
AMAZON_ASSOCIATE_TAG=


# =============================================================================
#  ◆ X (Twitter) 自動投稿 (schedule / post コマンドを使うなら必須)
# =============================================================================
#  取得先: https://developer.x.com/ (Free プランで API v2 が利用可)
#  必要権限: Read and write
#  認証方式: OAuth 1.0a User Context (tweepy.Client の create_tweet で必須)

# [7] API Key (Consumer Key)
#                                                ★ここに貼る★
X_API_KEY=

# [8] API Key Secret (Consumer Secret)
#                                                ★ここに貼る★
X_API_SECRET=

# [9] Access Token  (OAuth 1.0a・必須)
#   ※ 形式は ``1234567890-英数字`` のみ。OAuth 2.0 トークンはこの欄に入れない。
#   developer.x.com → Keys and tokens → Access Token and Secret → Generate
#                                                ★ここに貼る★
X_ACCESS_TOKEN=

# [10] Access Token Secret  (OAuth 1.0a・上とペア)
#                                                ★ここに貼る★
X_ACCESS_TOKEN_SECRET=

# [11] Bearer Token  (任意・v2 一部APIで使用)
#                                                ★ここに貼る★
X_BEARER_TOKEN=


# =============================================================================
#  ◆ 自作 Web サイト
# =============================================================================

# -----------------------------------------------------------------------------
# [12] 公開サイトURL (X 投稿テキスト末尾に貼られる)
# -----------------------------------------------------------------------------
#   例: https://detergent-price.example.com/
#                                                ★ここに貼る★
SITE_URL=https://minnaotokuni.github.io/detergent-price-compare/

# まとめ投稿の末尾ハッシュタグ（3つ・スペース区切り）
DIGEST_HASHTAGS=#日用品 #節約 #PR


# =============================================================================
#  ◆ まとめ投稿用 LLM (schedule / post-due … 1日2回のみ・無料枠は Ollama 推奨)
# =============================================================================
#  省略時: 起動中の Ollama (localhost:11434) を自動検出 → クラウド API より優先

# [13] Ollama（ローカル・課金なし）— ollama serve / ollama pull gemma2:9b
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma2:9b

# [14] OpenAI API Key  (クラウド利用時のみ)
OPENAI_API_KEY=

# [15] OpenAI モデル (任意・既定 gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# [16] Anthropic API Key  (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# [17] Anthropic モデル (任意)
ANTHROPIC_MODEL=claude-3-5-haiku-20241022
